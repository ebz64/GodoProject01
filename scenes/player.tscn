[sub_resource type="GDScript" id="GDScript_3vyb7"]
script/source = "
class_name GroundSensor
extends Area3D

var bodies: Array[PhysicsBody3D] = []


func _ready() -> void:
	monitoring = true
	monitorable = false
	collision_layer = 0
	collision_mask = 1

	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)


func _physics_process(_delta: float) -> void:
	for i in range(bodies.size() - 1, -1, -1):
		var body := bodies[i]

		if not is_instance_valid(body) or not body.is_inside_tree():
			bodies.remove_at(i)


func is_grounded() -> bool:
	return not bodies.is_empty()


func get_current_surface() -> GroundSurface:
	for i in range(bodies.size() - 1, -1, -1):
		var body := bodies[i]

		if is_instance_valid(body):
			var surface := body.get_node_or_null(\"GroundSurface\") as GroundSurface

			if surface != null:
				return surface

	return null


func _on_body_entered(body: Node3D) -> void:
	if body is PhysicsBody3D:
		var physics_body := body as PhysicsBody3D

		if not bodies.has(physics_body):
			bodies.append(physics_body)


func _on_body_exited(body: Node3D) -> void:
	if body is PhysicsBody3D:
		bodies.erase(body)
"

