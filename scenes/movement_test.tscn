[sub_resource type="GDScript" id="GDScript_debug"]
script/source = "
extends Label

@export var player: RigidBody3D

func _process(_delta: float) -> void:
	if not is_instance_valid(player):
		text = \"Player not assigned\"
		return

	var velocity := player.linear_velocity

	var horizontal_speed := Vector2(
		velocity.x,
		velocity.z
	).length()

	var total_speed := velocity.length()

	text = \"Horizontal: %.2f m/s\\nVertical: %.2f m/s\\nTotal: %.2f m/s\" % [
		horizontal_speed,
		velocity.y,
		total_speed
	]
"

